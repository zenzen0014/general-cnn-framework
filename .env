# ============================================================
# 1. DATASET
# ============================================================
# Pilihan: kaggle atau folder_lokal
SUMBER_DATASET=kaggle

# Digunakan jika SUMBER_DATASET=kaggle
KAGGLE_DATASET=wiratrnn/banana-ripeness-image-dataset

# Digunakan jika SUMBER_DATASET=folder_lokal
# Contoh Windows: D:/dataset/banana_ripeness
# Contoh Linux  : /home/user/dataset/banana_ripeness
FOLDER_LOKAL=

# Kosongkan, isi None, atau null jika ingin memakai semua gambar
MAX_PER_CLASS=400

# Total rasio harus 1.0
TRAIN_RATIO=0.70
VAL_RATIO=0.15
TEST_RATIO=0.15

# ============================================================
# 2. PREPROCESSING GAMBAR
# ============================================================
IMAGE_SIZE=224
AUGMENT_TRAIN=true

# ============================================================
# 3. TRAINING
# ============================================================
BATCH_SIZE=32
EPOCHS=30
LEARNING_RATE=0.001
WEIGHT_DECAY=0.0
NUM_WORKERS=2
DEVICE=auto

# ============================================================
# 4. MODEL
# ============================================================
# Pilihan: simple_cnn, resnet18, mobilenet_v3_small, efficientnet_b0
MODEL_NAME=simple_cnn
PRETRAINED=false
FREEZE_BACKBONE=false
DROPOUT=0.5

# ============================================================
# 5. OUTPUT
# ============================================================
OUTPUT_DIR=outputs
MODEL_FILENAME=best_model.pth
SEED=42
